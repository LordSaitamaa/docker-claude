# Squid egress proxy – whitelist-only, default deny

http_port 3128
visible_hostname squid-claude-proxy

# Disable ICMP pinger (container lacks NET_RAW capability)
pinger_enable off

# No caching (security proxy)
cache deny all
cache_mem 0 MB
maximum_object_size 0 KB

acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT    method CONNECT

# Whitelist (needed for claude code to work properly)
acl allowed_domains dstdomain .anthropic.com
acl allowed_domains dstdomain claude.ai
acl allowed_domains dstdomain .statsig.com
acl allowed_domains dstdomain .sentry.io
acl allowed_domains dstdomain raw.githubusercontent.com
acl allowed_domains dstdomain .datadoghq.com

# Dynamic entries via EXTRA_DOMAINS env var
${EXTRA_ACL_LINES}

# Examples (uncomment as needed):
# acl allowed_domains dstdomain .github.com
# acl allowed_domains dstdomain .gitlab.com
# acl allowed_domains dstdomain registry.npmjs.org
# acl allowed_domains dstdomain .npmjs.org

# Access control – default deny
http_access allow localhost manager
http_access deny !Safe_ports
http_access deny CONNECT !Safe_ports
http_access allow allowed_domains
http_access deny all

# Logging
access_log stdio:/var/log/squid/access.log
cache_log  /var/log/squid/cache.log

# Privacy
forwarded_for delete
via off

# Timeouts
connect_timeout 15 seconds
read_timeout    300 seconds
request_timeout 60 seconds